@startuml class-diagram
title Lumo & Nox - Klassendiagram
skinparam classAttributeIconSize 0
skinparam linetype ortho

enum Shape {
  Light
  Shadow
}

enum Controls {
  Wasd
  Arrows
}

class Player <<MonoBehaviour>> {
  ' Lumo en Nox zijn twee instanties met andere instellingen
  - controls : Controls
  - startShape : Shape
  - lightSprite : Sprite
  - shadowSprite : Sprite
  - glowRadius : float
  - jumpForce : float
  - canPushBoxes : bool
  - moveSpeed : float
  - isGrounded : bool
  - isDead : bool
  - isUsingAbility : bool
  + CurrentShape : Shape
  + Move(direction : float) : void
  + Jump() : void
  + UseAbility() : void
  + StopAbility() : void
  + Interact() : void
  + SetShape(newShape : Shape) : void
  + Die() : void
  + Respawn(position : Vector2) : void
}

class SwapManager <<MonoBehaviour>> {
  - roundTime : float
  - warningTime : float
  - timeLeft : float
  + ResetTimer() : void
  - Warn() : void
  - Swap() : void
}

interface ISwapTimer {
  + ResetTimer() : void
}

interface IPlayer {
  + CurrentShape : Shape
  + Die() : void
  + Respawn(position : Vector2) : void
}

class PlayerDummy <<MonoBehaviour>> {
  - startShape : Shape
  - isDead : bool
}

note bottom of PlayerDummy
  alleen voor testen in de Sandbox
end note

abstract class Zone <<MonoBehaviour>> {
  - playersInside : HashSet<Collider2D>
  + {abstract} IsDangerousFor(shape : Shape) : bool
  # OnTriggerEnter2D(other : Collider2D) : void
  # OnTriggerExit2D(other : Collider2D) : void
  - FixedUpdate() : void
}

class LightZone <<MonoBehaviour>> {
  + IsDangerousFor(shape : Shape) : bool
}

class DarkZone <<MonoBehaviour>> {
  + IsDangerousFor(shape : Shape) : bool
}

class HazardZone <<MonoBehaviour>> {
  + IsDangerousFor(shape : Shape) : bool
}

abstract class Activatable <<MonoBehaviour>> {
  + {abstract} Activate() : void
  + {abstract} Deactivate() : void
}

class Lamp <<MonoBehaviour>> {
  - isOn : bool
  - maxBeamLength : float
  - onSprite : Sprite
  - offSprite : Sprite
  + Activate() : void
  + Deactivate() : void
}

class Door <<MonoBehaviour>> {
  - isOpen : bool
  - openSprite : Sprite
  - closedSprite : Sprite
  + Activate() : void
  + Deactivate() : void
}

class MovingPlatform <<MonoBehaviour>> {
  - pointA : Transform
  - pointB : Transform
  - speed : float
  - isMoving : bool
  - body : Rigidbody2D
  - target : Transform
  + Activate() : void
  + Deactivate() : void
  - Move() : void
}

class Lever <<MonoBehaviour>> {
  - isOn : bool
  - onSprite : Sprite
  - offSprite : Sprite
  + Use() : void
}

class PressButton <<MonoBehaviour>> {
  - isPressed : bool
  - objectsOnButton : int
  - upSprite : Sprite
  - downSprite : Sprite
  # OnTriggerEnter2D(other : Collider2D) : void
  # OnTriggerExit2D(other : Collider2D) : void
}

class LightPlatform <<MonoBehaviour>> {
  - isRevealed : bool
  - revealedSprite : Sprite
  - hiddenSprite : Sprite
  + SetRevealed(revealed : bool) : void
}

class ShadowWall <<MonoBehaviour>> {
  - isPassable : bool
  - passingPlayers : HashSet<Collider2D>
  + SetPassable(player : Collider2D, passable : bool) : void
}

class PushBox <<MonoBehaviour>> {
  - body : Rigidbody2D
  - pushSpeed : float
  + Push(direction : Vector2) : void
}

class Checkpoint <<MonoBehaviour>> {
  - isActive : bool
  - passedPlayers : HashSet<GameObject>
  - litSprite : Sprite
  # OnTriggerEnter2D(other : Collider2D) : void
}

class Crystal <<MonoBehaviour>> {
  - isCollected : bool
  # OnTriggerEnter2D(other : Collider2D) : void
}

class ExitPortal <<MonoBehaviour>> {
  - playersInside : HashSet<GameObject>
  # OnTriggerEnter2D(other : Collider2D) : void
  # OnTriggerExit2D(other : Collider2D) : void
}

class LevelManager <<MonoBehaviour>> {
  - levelIndex : int
  - startPoint : Transform
  - deaths : int
  - elapsedTime : float
  - crystals : int
  - isRespawning : bool
  - isFinished : bool
  + Deaths : int
  + ElapsedTime : float
  + Crystals : int
  + OnPlayerDied() : void
  + SetCheckpoint(checkpoint : Checkpoint) : void
  + AddCrystal() : void
  + FinishLevel() : void
  - Respawn() : void
}

class GameManager <<MonoBehaviour>> {
  + {static} Instance : GameManager
  + {static} LevelNames : string[]
  - data : SaveData
  + Data : SaveData
  + LoadLevel(index : int) : void
  + LoadMainMenu() : void
  + ReloadScene() : void
  + LoadProgress() : void
  + SaveProgress(levelIndex : int, time : float, crystals : int) : void
  + SaveSettings() : void
  + ApplySettings() : void
  + {static} FormatTime(seconds : float) : string
  + IsUnlocked(levelIndex : int) : bool
  + FirstUnfinishedLevel() : int
}

class MainMenu <<MonoBehaviour>> {
  - startPanel : GameObject
  - mainPanel : GameObject
  - levelSelectPanel : GameObject
  - levelButtons : Button[]
  - levelInfoTexts : Text[]
  + ShowStart() : void
  + ShowMain() : void
  + ShowLevelSelect() : void
  + OpenOptions() : void
  + Play() : void
  + SelectLevel(index : int) : void
  + Quit() : void
}

class HUD <<MonoBehaviour>> {
  - timerBar : Slider
  - crystalText : TextMeshProUGUI
  + UpdateTimer(timeLeft : float) : void
  + UpdateShape(player : Player) : void
}

class PauseMenu <<MonoBehaviour>> {
  - panel : GameObject
  - resumeButton : Button
  - optionsMenu : OptionsMenu
  + Show() : void
  + Resume() : void
  + Restart() : void
  + OpenOptions() : void
  + GoToMainMenu() : void
}

class OptionsMenu <<MonoBehaviour>> {
  - musicSlider : Slider
  - sfxSlider : Slider
  - fullscreenToggle : Toggle
  - flashToggle : Toggle
  - panel : GameObject
  + IsOpen : bool
  + Show(cameFrom : GameObject) : void
  + OnSettingChanged() : void
  + Back() : void
}

class WinScreen <<MonoBehaviour>> {
  - panel : GameObject
  - levelText : Text
  - timeText : Text
  - crystalText : Text
  - deathText : Text
  - crystalIcons : Image[]
  - nextButton : Button
  + Show(levelIndex : int, time : float, crystals : int, deaths : int) : void
  + NextLevel() : void
  + Restart() : void
  + GoToMainMenu() : void
}

class SaveData {
}

note right of SaveData
  zie data-model.puml
end note

class Palette <<static>> {
  + {static} steen : Color
  + {static} rots : Color
  + {static} kristal : Color
  ...
}

' Overerving
Zone <|-- LightZone
Zone <|-- DarkZone
Zone <|-- HazardZone
Activatable <|-- Lamp
Activatable <|-- Door
Activatable <|-- MovingPlatform

' Player
Player --> "1" Shape : shape
Player --> "1" Controls : controls
Player --> "1" LevelManager : meldt dood
Player ..> "0..*" PushBox : duwt
Player ..> "0..*" LightPlatform : Gloed
Player ..> "0..*" ShadowWall : Schaduwstap
Player ..> "0..*" Lever : Use()
Zone ..> "0..*" IPlayer : checkt
IPlayer <|.. Player
IPlayer <|.. PlayerDummy

' Wissel en level
SwapManager --> "2" Player : players
LevelManager --> "2" IPlayer : Respawn()
LevelManager --> "0..1" ISwapTimer : ResetTimer()
ISwapTimer <|.. SwapManager
LevelManager --> "0..1" Checkpoint : currentCheckpoint

' Zij roepen LevelManager aan
Checkpoint --> "1" LevelManager
Crystal --> "1" LevelManager
ExitPortal --> "1" LevelManager : FinishLevel()

' Schakelaars sturen iets aan
Lever "0..*" --> "1" Activatable : target
PressButton "0..*" --> "1" Activatable : target
Lamp *-- "1" LightZone : beam
Lamp ..> "0..*" PushBox : straal stopt bij kist
PressButton ..> "0..*" PushBox : telt mee

' UI
HUD --> "1" SwapManager
HUD --> "1" LevelManager
LevelManager --> "1" WinScreen
LevelManager ..> "1" GameManager : SaveProgress()
MainMenu ..> "1" GameManager
PauseMenu ..> "1" GameManager
WinScreen ..> "1" GameManager
MainMenu ..> "1" OptionsMenu : Opties
PauseMenu ..> "1" OptionsMenu : Opties
OptionsMenu ..> "1" GameManager : SaveSettings()
SwapManager ..> "1" GameManager : leest flashWarning
GameManager --> "1" SaveData
@enduml
